# Keys and local settings: never commit these
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Local machine files
.DS_Store
.claude/settings.local.json

# Benchmark data and run workspaces stay local (they hold answer keys and large files)
data/
runs/
*.log

# Builders work in their own copies here
.claude/worktrees/
